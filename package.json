{
  "name": "@edward1993/img-editor",
  "version": "2.0.2",
  "type": "module",
  "description": "Compact image editing library",
  "main": "./dist/lib/imgEditor.js",
  "bin": {
    "img-editor": "./dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "docs": "npm run gen-docs-md",
    "deploy": "npm publish --access=public",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test-c": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build": "tsc -p tsconfig.json",
    "gen-docs-md": "typedoc --options typedoc.json",
    "predeploy": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edward93/img-editor.git"
  },
  "keywords": [
    "sharp",
    "resize",
    "images",
    "image manipulation"
  ],
  "author": "Edward Chopuryan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edward93/img-editor/issues"
  },
  "homepage": "https://github.com/edward93/img-editor#readme",
  "dependencies": {
    "esm": "^3.2.25",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "path": "^0.12.7",
    "sharp": "^0.34.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.2",
    "@types/yargs": "^17.0.33",
    "copyfiles": "^2.4.1",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "jest-watch-typeahead": "^3.0.1",
    "minami": "^1.2.3",
    "ts-jest": "^29.4.0",
    "typedoc": "^0.28.6",
    "typedoc-plugin-markdown": "^3.13.4",
    "typescript": "^5.8.3"
  }
}
